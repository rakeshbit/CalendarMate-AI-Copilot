{
  "name": "Meeting Notes Consolidator Agent",
  "nodes": [
    {
      "parameters": {
        "resource": "fileFolder",
        "limit": 4,
        "filter": {
          "folderId": {
            "__rl": true,
            "value": "YOUR_FOLDER_ID",
            "mode": "list",
            "cachedResultName": "Meeting Notes Transcript",
            "cachedResultUrl": "https://drive.google.com/drive/folders/YOUR_FOLDER_ID"
