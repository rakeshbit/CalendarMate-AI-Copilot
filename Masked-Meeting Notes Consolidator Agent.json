      "alwaysOutputData": true,
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "CREDENTIAL_ID",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Please analyze and consolidate the following raw meeting text into a clean, beautifully formatted HTML email digest. Return ONLY valid HTML (do not enclose it in markdown code fences like ```html).\n\nRAW MEETING NOTES:\n{{ $json.text }}\n\nHTML Template Structure:\n\n<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; color: #333333; line-height: 1.6;\">\n  <h2 style=\"color: #1a73e8; border-bottom: 2px solid #1a73e8; padding-bottom: 8px;\">📝 Meeting Summary</h2>\n  \n  <h3 style=\"color: #202124; margin-top: 20px;\">📌 Executive Summary</h3>\n  <p style=\"background-color: #f8f9fa; padding: 12px; border-left: 4px solid #1a73e8; margin: 0;\">\n    [Insert Executive Summary]\n  </p>\n  \n  <h3 style=\"color: #202124; margin-top: 20px;\">🎯 Key Decisions Made</h3>\n  <ul style=\"padding-left: 20px;\">\n    <li>[Decision 1]</li>\n    <li>[Decision 2]</li>\n  </ul>\n  \n  <h3 style=\"color: #202124; margin-top: 20px;\">✅ Action Items</h3>\n  <table style=\"width: 100%; border-collapse: collapse; margin-top: 10px;\">\n    <thead>\n      <tr style=\"background-color: #f1f3f4; text-align: left;\">\n        <th style=\"padding: 8px; border: 1px solid #dadce0;\">Assignee</th>\n        <th style=\"padding: 8px; border: 1px solid #dadce0;\">Task</th>\n        <th style=\"padding: 8px; border: 1px solid #dadce0;\">Due Date</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr>\n        <td style=\"padding: 8px; border: 1px solid #dadce0;\"><strong>[Assignee]</strong></td>\n        <td style=\"padding: 8px; border: 1px solid #dadce0;\">[Task description]</td>\n        <td style=\"padding: 8px; border: 1px solid #dadce0;\">[Date/Not specified]</td>\n      </tr>\n    </tbody>\n  </table>\n  \n  <h3 style=\"color: #202124; margin-top: 20px;\">❓ Open Discussion & Next Steps</h3>\n  <ul style=\"padding-left: 20px;\">\n    <li>[Follow-up item 1]</li>\n    <li>[Follow-up item 2]</li>\n  </ul>\n</div>",
        "messages": {
          "messageValues": [
            {
              "message": "You are an expert Executive Assistant and AI Meeting Summarizer. Your goal is to convert raw, unstructured meeting notes, transcripts, or plain-text files into clear, actionable, and visually structured meeting digests. Guidelines: 1. Always maintain a professional, conciseness-first tone. 2. Structure the summary into standard business meeting sections: Executive Summary, Key Decisions, Action Items, and Open Questions/Next Steps. 3. For Action Items, always attempt to identify: - Assignee (Who) - Task Description (What) - Deadline/DueDate (When - mark \"Not specified\" if absent) 4. Do not invent or fabricate details not explicitly mentioned in the source text. 5. Format the entire response cleanly using Markdown for readability."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        -1376,
        32
      ],
      "id": "2671563a-6da9-4804-9807-6ad280b0fbf0",
      "name": "Basic LLM Chain"
    },
