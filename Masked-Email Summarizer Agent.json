    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze the following email body: {{ $json.text }} 1. Priority: Assign Urgent, Action needed, or FYI. 2. Summary: Write a 1-line summary. 3. Action: Suggest a brief response or action. Return strictly valid JSON: {\"priority\": \"\", \"summary\": \"\", \"action\": \"\"}\n\n\n________________________________________________________________________________________\"Please output the entire response strictly in Markdown format. Do not use any HTML tags, inline styles, or raw code blocks.\"",
