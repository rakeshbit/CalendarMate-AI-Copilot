    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  let raw = item.json.output || \"\";\n  \n  // Clean markdown backticks and trim\n  let cleaned = raw.replace(/```json/g, '').replace(/```/g, '').trim();\n\n  // Strip leading/trailing quotes if the string is wrapped in a JSON string literal\n  if (cleaned.startsWith('\"') && cleaned.endsWith('\"')) {\n    try {\n      cleaned = JSON.parse(cleaned);\n    } catch (e) {\n      // Fallback in case stripping outer quotes fails\n      cleaned = cleaned.slice(1, -1);\n    }\n  }\n\n  let parsedObj;\n  try {\n    parsedObj = typeof cleaned === 'string' ? JSON.parse(cleaned) : cleaned;\n    \n    // Ensure the result is a valid key-value object (not a primitive or array)\n    if (typeof parsedObj !== 'object' || parsedObj === null || Array.isArray(parsedObj)) {\n      throw new Error(\"Parsed result is not a valid object\");\n    }\n  } catch (e) {\n    parsedObj = {\n      priority: \"FYI\",\n      summary: raw,\n      action: \"\"\n    };\n  }\n\n  return { json: parsedObj };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
